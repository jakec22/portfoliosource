# Copy to .env and fill in with your own Supabase project's values (Project
# Settings -> API in the Supabase dashboard). EXPO_PUBLIC_* vars are inlined
# into the app bundle. The anon/publishable key is safe to ship — Row-Level
# Security (see supabase/schema.sql) protects the data. Never put the
# secret/service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
