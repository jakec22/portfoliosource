# Intermediates: gen.py rewrites these, shoot.js reads them, and watch.js
# writes its own (several MB of embedded fonts) on every run.
slide*.html
watch.html
# Anything rendered at a prefix other than the committed `appstore-*`.
preview-*.png
check-*.png

# The meal photo is a real photograph you supply; it is not committed.
meal.jpg
meal.jpeg
meal.png
