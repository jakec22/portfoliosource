# Copy to .env and fill in. EXPO_PUBLIC_* vars are inlined into the app bundle.
# The Supabase anon/publishable key is safe to ship — Row-Level Security
# protects the data. Never put the secret/service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: override the bundled USDA FoodData Central key.
# EXPO_PUBLIC_USDA_API_KEY=your-usda-key

# Optional: Nutritionix (restaurant / branded foods). Free keys at
# https://developer.nutritionix.com. When unset, Nutritionix is skipped.
# EXPO_PUBLIC_NUTRITIONIX_APP_ID=your-nutritionix-app-id
# EXPO_PUBLIC_NUTRITIONIX_APP_KEY=your-nutritionix-app-key
